{
  "name": "ai-mystery-room",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["shared", "client", "server"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev --workspace=server\" \"npm:dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "seed:demo": "npm run seed:demo --workspace=server",
    "start": "npm start --workspace=server"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
